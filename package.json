{
  "name": "inkframe",
  "version": "2026.8.0",
  "description": "A local-first Markdown-to-PDF CLI for polished documents",
  "author": "Pongotsu26",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "bin": {
    "inkframe": "./dist/cli.js"
  },
  "files": [
    "dist/cli.*",
    "dist/config.*",
    "dist/fonts.*",
    "dist/html.*",
    "dist/output-path.*",
    "dist/page-size.*",
    "dist/renderer.*",
    "dist/themes.*",
    "dist/types.*",
    "themes",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "legal:generate": "node scripts/generate-third-party-notices.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "mermaid": "^11.12.1",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.55.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.12.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "pdfjs-dist": "^6.1.200",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
