{
  "name": "inkframe",
  "productName": "Inkframe",
  "version": "2026.7.1",
  "description": "A local-first Markdown typesetting studio for polished PDFs",
  "author": "Pongotsu26",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "./dist/desktop/main.js",
  "bin": {
    "inkframe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "themes",
    "desktop",
    "assets",
    "LICENSE",
    "BRAND_ASSETS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "build": {
    "appId": "dev.inkframe.app",
    "productName": "Inkframe",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "BRAND_ASSETS.md",
        "to": "legal/BRAND_ASSETS.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "legal/ELECTRON_LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "legal/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "icon": "assets/Inkframe.icon"
    },
    "dmg": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon.png"
    },
    "win": {
      "icon": "assets/icon.png"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm renderer:build",
    "renderer:build": "vite build",
    "renderer:dev": "vite",
    "icon:build": "magick -background none assets/icon.svg -alpha on -depth 8 -define png:color-type=6 assets/icon.png && png2icons assets/icon.png assets/icon -icns -bc",
    "legal:generate": "node scripts/generate-third-party-notices.mjs",
    "prepackage:mac": "pnpm legal:generate",
    "package:mac": "node scripts/package-mac.mjs",
    "theme:extract": "node scripts/theme-tokens-to-css.mjs design/inkframe-dark.tokens.json src/renderer/src/styles/inkframe-theme.css",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "desktop": "pnpm build && electron .",
    "test": "vitest run --config vitest.config.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "mermaid": "^11.12.1",
    "pagedjs": "^0.4.3",
    "playwright": "^1.55.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.12.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.4"
  }
}
